# ---------------------------------------------------------------------------
# Your data. Never commit this.
#
# `data/` holds the SQLite database, every uploaded image and audio file, and
# `agent-key.txt` — the key that grants full read/write access to the API.
# It is also the only folder you need to back up.
# ---------------------------------------------------------------------------
data/

# Decks and backups you export. These are your cards, not source code.
*.fcdeck
*.apkg
flashcards-backup-*.json

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# TLS certificates, if you ever put this behind HTTPS on the home server.
*.pem
*.key
*.crt

# Android signing. Committing these to a public repo would let anyone publish
# updates as you, and the keystore cannot be regenerated — lose it and you can
# never update an installed app, only replace it.
*.jks
*.keystore
key.properties
android/key.properties

# Capacitor / Android build output. The android/ folder itself is meant to be
# committed; what Gradle generates inside it is not.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
# Copied in by `cap sync` from out/ — regenerated on every device build.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/capacitor-cordova-android-plugins/
android/.idea/
ios/App/build/
*.apk
*.aab

# Personal scratch kept out of the public repo but left on disk.
LANDING_PAGE_PROMPT.md

# Claude Code's per-machine settings. `launch.json` is shared project config
# and is deliberately left tracked.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Build output and dependencies
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Logs and scratch
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.next-device/
