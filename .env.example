# ---------------------------------------------------------------------------
# flashCards.io configuration. Copy to .env.local and edit.
# Every value here is optional — the app runs with sensible defaults.
# ---------------------------------------------------------------------------

# Where the SQLite database and uploaded media are stored.
# Relative paths are resolved from the project root.
FC_DATA_DIR=./data

# Key that external AI agents must send as `Authorization: Bearer <key>`
# when calling /api/v1/*. If left empty, a key is generated on first boot and
# written to data/agent-key.txt (also shown in Settings).
FC_AGENT_KEY=

# Set to 1 if you host this on your home server and want the web UI to require
# the agent key once (stored in a cookie afterwards, so you unlock it one time).
# Leave unset/0 for a laptop — the UI then opens with zero friction.
FC_LOCK_UI=0

# Max upload size per file, in megabytes.
FC_MAX_UPLOAD_MB=64
